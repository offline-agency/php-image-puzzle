{
  "name": "image-puzzle-workspace",
  "private": true,
  "description": "Browser engine, players and framework adapters for offline-agency/image-puzzle.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/engine",
    "packages/player",
    "packages/react",
    "packages/vue"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:browser": "npm run test:browser --workspace packages/player",
    "sync:bundles": "node tools/sync-player-bundle.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vue/compiler-dom": "3.5.43",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue": "3.5.43"
  }
}
