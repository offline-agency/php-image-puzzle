{
    "name": "offline-agency/image-puzzle",
    "description": "Generate real interlocking jigsaw and image-puzzle assets with GD: deterministic geometry, PNG/JPEG/WebP pieces, versioned JSON manifests and game definitions.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "puzzle",
        "jigsaw",
        "image",
        "gd",
        "image-processing",
        "sliding-puzzle",
        "tiles",
        "game",
        "manifest"
    ],
    "homepage": "https://github.com/offline-agency/php-image-puzzle",
    "authors": [
        {
            "name": "Offline Agency",
            "homepage": "https://github.com/offline-agency"
        }
    ],
    "support": {
        "issues": "https://github.com/offline-agency/php-image-puzzle/issues",
        "source": "https://github.com/offline-agency/php-image-puzzle",
        "docs": "https://github.com/offline-agency/php-image-puzzle/tree/HEAD/docs",
        "security": "https://github.com/offline-agency/php-image-puzzle/security/policy"
    },
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "ext-gd": "*",
        "ext-json": "*"
    },
    "suggest": {
        "ext-pcntl": "Parallel export in CLI processes (Linux/macOS).",
        "ext-zip": "Self-contained ZIP bundles (image-puzzle bundle).",
        "ext-exif": "Not required: type detection falls back to getimagesize(). Needed only for EXIF orientation metadata reading."
    },
    "require-dev": {
        "laravel/pint": "^1.32.1",
        "opis/json-schema": "^2.6",
        "pestphp/pest": "^5.3.3",
        "phpstan/phpstan": "^2.3.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.4.3"
    },
    "autoload": {
        "psr-4": {
            "ImagePuzzle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ImagePuzzle\\Tests\\": "tests/",
            "ImagePuzzle\\Tools\\": "tools/src/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:process": "pest --group=process",
        "test:coverage": "pest --coverage --min=85",
        "analyse": "phpstan analyse --memory-limit=1G --no-progress",
        "format": "pint",
        "format:check": "pint --test",
        "schemas": "php tools/validate-schemas.php",
        "conformance": "php tools/conformance.php",
        "mutate": ["Composer\\Config::disableProcessTimeout", "tools/mutation/run.sh"],
        "benchmark": "php tools/benchmark.php",
        "release:test": "php tools/release/run-scenarios.php",
        "qa": [
            "@composer validate --strict",
            "@composer dump-autoload --strict-psr --dry-run",
            "@format:check",
            "@analyse",
            "@test",
            "@schemas"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
