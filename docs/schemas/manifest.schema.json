{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gfabbian/php-image-puzzle/schemas/manifest.schema.json",
  "title": "Puzzle manifest",
  "description": "Exported puzzle manifest (piece list and metadata).",
  "type": "object",
  "required": ["source", "rows", "cols", "sourceWidth", "sourceHeight", "pieces"],
  "properties": {
    "source": {
      "type": ["string", "null"],
      "description": "Source image basename or null."
    },
    "rows": {
      "type": "integer",
      "minimum": 1
    },
    "cols": {
      "type": "integer",
      "minimum": 1
    },
    "sourceWidth": {
      "type": "integer",
      "minimum": 1
    },
    "sourceHeight": {
      "type": "integer",
      "minimum": 1
    },
    "pieces": {
      "type": "array",
      "items": { "$ref": "piece.schema.json" },
      "description": "One entry per piece."
    }
  },
  "additionalProperties": false
}
