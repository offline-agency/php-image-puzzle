{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gfabbian/php-image-puzzle/schemas/piece.schema.json",
  "title": "Piece",
  "description": "One piece entry in the exported puzzle manifest.",
  "type": "object",
  "required": ["row", "col", "x", "y", "width", "height", "filename"],
  "properties": {
    "row": {
      "type": "integer",
      "minimum": 0,
      "description": "Row index in the puzzle grid."
    },
    "col": {
      "type": "integer",
      "minimum": 0,
      "description": "Column index in the puzzle grid."
    },
    "x": {
      "type": "integer",
      "minimum": 0,
      "description": "Top-left X offset in the source image."
    },
    "y": {
      "type": "integer",
      "minimum": 0,
      "description": "Top-left Y offset in the source image."
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "description": "Piece width in pixels."
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "description": "Piece height in pixels."
    },
    "filename": {
      "type": "string",
      "description": "Piece image filename in the output directory."
    }
  },
  "additionalProperties": false
}
