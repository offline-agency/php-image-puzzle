{
    "name": "offline-agency/image-puzzle-livewire",
    "description": "Livewire player component for offline-agency/image-puzzle game definitions: authorized definition and asset routes, server-validated saves, pluggable state storage.",
    "type": "library",
    "license": "MIT",
    "keywords": ["puzzle", "jigsaw", "livewire", "laravel", "game"],
    "homepage": "https://github.com/offline-agency/php-image-puzzle",
    "support": {
        "issues": "https://github.com/offline-agency/php-image-puzzle/issues",
        "source": "https://github.com/offline-agency/php-image-puzzle",
        "docs": "https://github.com/offline-agency/php-image-puzzle/tree/HEAD/docs/LIVEWIRE.md"
    },
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "illuminate/bus": "^13.35",
        "illuminate/contracts": "^13.35",
        "illuminate/http": "^13.35",
        "illuminate/queue": "^13.35",
        "illuminate/routing": "^13.35",
        "illuminate/support": "^13.35",
        "livewire/livewire": "^4.4.8",
        "offline-agency/image-puzzle": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13.2",
        "laravel/pint": "^1.32.1",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3.3",
        "phpstan/phpstan": "^2.3.2",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ImagePuzzle\\Livewire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ImagePuzzle\\Livewire\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ImagePuzzle\\Livewire\\ImagePuzzleServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true,
                "versions": {
                    "offline-agency/image-puzzle": "2.0.0"
                }
            }
        }
    ],
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G --no-progress",
        "format": "pint",
        "format:check": "pint --test",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
